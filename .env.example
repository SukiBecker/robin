# Kopieren nach .env.local und mit den Werten des eigenen Supabase-Projekts füllen.
# Beide Werte stehen im Supabase-Dashboard unter Project Settings -> API
# (bzw. "Connect"). Der anon/publishable Key ist für den Browser gedacht und
# durch Row Level Security geschützt; keinen service_role-Key hier eintragen.

# Projekt-URL, z. B. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon (public) Key des Projekts
NEXT_PUBLIC_SUPABASE_ANON_KEY=
